# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-random-32-char-string
NEXTAUTH_URL=http://localhost:3000

# Database — SQLite for local dev, Postgres/Supabase for production
DATABASE_URL=file:/home/z/my-project/db/custom.db
# Production example:
# DATABASE_URL=postgresql://user:pass@host:5432/leadscraper?schema=public

# Optional: OpenAI API key for Phase 3 owner-name extraction (LLM enrichment)
# OPENAI_API_KEY=sk-...

# Optional: Default proxy (used if no ProxyConfig selected for a job)
# DEFAULT_PROXY=http://user:pass@host:port
